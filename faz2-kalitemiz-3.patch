diff --git a/components/quality-bag-showcase.tsx b/components/quality-bag-showcase.tsx
new file mode 100644
index 0000000..c06b161
--- /dev/null
+++ b/components/quality-bag-showcase.tsx
@@ -0,0 +1,65 @@
+'use client';
+
+import { useEffect, useRef, useState } from 'react';
+import Image from 'next/image';
+import { AnimatePresence, motion, useInView } from 'framer-motion';
+
+const BAGS = ['/baker-flour.png', '/multi-purpose-flour.png', '/biscuit-flour.png'];
+
+/**
+ * Sahne görüntüye girdiğinde: 3 un çuvalı sırayla, 2'şer saniyelik hızlı
+ * "flaş" kesmeleriyle tek tek belirir (bir kamera flaşı hissi). Üçü de
+ * gösterildikten sonra hoş bir geçişle hepsi birlikte, sakin bir sırada
+ * ekranda kalıcı olarak yerleşir. Bir kez oynar, tekrar etmez.
+ */
+export function QualityBagShowcase() {
+  const ref = useRef<HTMLDivElement>(null);
+  const inView = useInView(ref, { once: true, amount: 0.5 });
+  // -1: henüz başlamadı, 0..BAGS.length-1: o çuval flaşta, BAGS.length: final yerleşim
+  const [stage, setStage] = useState(-1);
+
+  useEffect(() => {
+    if (!inView) return;
+    const timers = BAGS.map((_, i) => setTimeout(() => setStage(i), i * 2000));
+    timers.push(setTimeout(() => setStage(BAGS.length), BAGS.length * 2000));
+    return () => timers.forEach(clearTimeout);
+  }, [inView]);
+
+  const isFinal = stage >= BAGS.length;
+
+  return (
+    <div ref={ref} className="quality-bag-showcase">
+      <AnimatePresence mode="wait">
+        {!isFinal && stage >= 0 && (
+          <motion.div key={`flash-${stage}`} className="quality-bag-flash-stage" exit={{ opacity: 0 }}>
+            <motion.div
+              className="quality-bag-flash-overlay"
+              initial={{ opacity: 0.85 }}
+              animate={{ opacity: 0 }}
+              transition={{ duration: 0.4 }}
+            />
+            <motion.div
+              initial={{ scale: 0.82, opacity: 0 }}
+              animate={{ scale: 1, opacity: 1 }}
+              transition={{ duration: 0.3 }}
+            >
+              <Image src={BAGS[stage]} alt="" width={190} height={250} />
+            </motion.div>
+          </motion.div>
+        )}
+      </AnimatePresence>
+      {isFinal && (
+        <motion.div
+          className="quality-bag-final-row"
+          initial={{ opacity: 0, y: 18 }}
+          animate={{ opacity: 1, y: 0 }}
+          transition={{ duration: 0.7, ease: 'easeOut' }}
+        >
+          {BAGS.map((src) => (
+            <Image key={src} src={src} alt="" width={170} height={225} />
+          ))}
+        </motion.div>
+      )}
+    </div>
+  );
+}
