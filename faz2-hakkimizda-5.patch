diff --git a/app/globals.css b/app/globals.css
index f87bec6..1eeafa9 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -281,6 +281,17 @@ h1 em, h2 em { font-family: var(--font-caveat), cursive; font-weight: 500; color
 .page-hero .eyebrow span { background: var(--gold); }
 .page-hero-content > p:last-child { max-width: 410px; font-size: 15px; line-height: 1.65; color: rgba(255,255,255,.74); margin-top: 20px; }
 
+/* ===== İÇ SAYFA HERO — açık (beyaz) varyasyon =====
+   İki koyu/lacivert bölümün art arda gelmesini istemediğimiz sayfalarda
+   (örn. Hakkımızda) kullanılır: zemin beyaz, başlık lacivert, fotoğraf
+   sağda kalır ve soldaki metin alanına doğru beyaza yumuşar. */
+.page-hero-light { background: #fff; color: var(--navy); }
+.page-hero-light .page-hero-shade {
+  background: linear-gradient(90deg, #fff 0%, rgba(255,255,255,.94) 32%, rgba(255,255,255,.62) 50%, rgba(255,255,255,.15) 68%, rgba(255,255,255,0) 82%);
+}
+.page-hero-light h1 { color: var(--navy); }
+.page-hero-light .page-hero-content > p:last-child { color: rgba(34,48,87,.72); }
+
 .quality-copy { background: var(--cream); }
 .about-grid, .quality-layout { align-items: start; }
 .quality-copy h2 { font-size: clamp(38px, 5vw, 64px); }
diff --git a/app/hakkimizda/page.tsx b/app/hakkimizda/page.tsx
index 03d7a60..b114045 100644
--- a/app/hakkimizda/page.tsx
+++ b/app/hakkimizda/page.tsx
@@ -25,7 +25,8 @@ export default function AboutPage() {
           </>
         }
         text="Kalite, dinamizm ve profesyonellik ile dünyanın dört bir yanına ulaşan bir ortaklık."
-        image="/hero-photo.jpg"
