+        theme="light"
       />
 
       <section className="about-navy-block">
diff --git a/components/page-hero.tsx b/components/page-hero.tsx
index 49cc398..25f7687 100644
--- a/components/page-hero.tsx
+++ b/components/page-hero.tsx
@@ -7,19 +7,24 @@ export function PageHero({
   title,
   text,
   image,
+  theme = 'dark',
 }: {
   eyebrow: string;
   title: ReactNode;
   text: string;
   image?: string;
+  /** 'dark' (varsayılan): mevcut lacivert/fotoğraf üstü beyaz metin.
+   *  'light': beyaz zemin, lacivert başlık — iki koyu bölümün art arda
+   *  gelmesini istemediğimiz sayfalarda (örn. Hakkımızda) kullanılır. */
+  theme?: 'dark' | 'light';
 }) {
   return (
-    <section className="page-hero">
+    <section className={`page-hero ${theme === 'light' ? 'page-hero-light' : ''}`}>
       {image ? <Image src={image} alt="" fill priority sizes="100vw" /> : null}
       <div className="page-hero-shade" />
       <div className="container page-hero-content">
         <Reveal>
-          <p className="eyebrow light">
+          <p className={theme === 'light' ? 'eyebrow' : 'eyebrow light'}>
             <span /> {eyebrow}
           </p>
           <h1>{title}</h1>
