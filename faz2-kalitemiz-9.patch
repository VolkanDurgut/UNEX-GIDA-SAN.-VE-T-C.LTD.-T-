diff --git a/components/quality-product-showcase.tsx b/components/quality-product-showcase.tsx
new file mode 100644
index 0000000..fb1d484
--- /dev/null
+++ b/components/quality-product-showcase.tsx
@@ -0,0 +1,60 @@
+import Image from 'next/image';
+import { products } from '@/lib/data';
+
+/** Paket ağırlıkları veri modelinde yok (bagların üzerinde basılı) —
+ *  gerçek kataloğa göre burada eşleniyor. */
+const WEIGHTS: Record<string, string> = {
+  'biscuit-flour': '25kg',
+  'multi-purpose-flour': '25kg',
+  'baker-flour': '50kg',
+  'baker-plus-flour': '50kg',
+  'super-baker-flour': '50kg',
+  'noodle-and-pasta-flour': '25kg',
+};
+
+const LEFT_SLUGS = ['baker-plus-flour', 'biscuit-flour', 'super-baker-flour'];
+const RIGHT_SLUGS = ['baker-flour', 'multi-purpose-flour', 'noodle-and-pasta-flour'];
+
+function ProductBadgeCard({ slug }: { slug: string }) {
+  const product = products.find((p) => p.slug === slug);
+  if (!product || !product.image) return null;
+
+  return (
+    <div className="quality-product-card">
+      <span className="quality-product-flag" aria-hidden="true">
+        🇹🇷
+      </span>
+      <Image src={product.image} alt={product.name} width={92} height={120} />
+      <p>
+        {product.name}
+        <br />
+        <span>{WEIGHTS[slug]}</span>
+      </p>
+    </div>
+  );
+}
+
+/**
+ * "İşinizi ileri taşırız" bölümü için: 6 gerçek ürünümüz, Türk bayrağı
+ * rozetli, ortada yavaşça dönen bir dünya görseliyle iki yana ayrılmış
+ * halde. Katalogda gördüğümüz şablonun bizim ürün setimize uyarlanmış hali.
+ */
+export function QualityProductShowcase() {
+  return (
+    <div className="quality-product-showcase">
+      <div className="quality-product-group">
+        {LEFT_SLUGS.map((slug) => (
+          <ProductBadgeCard key={slug} slug={slug} />
+        ))}
+      </div>
+      <div className="quality-globe">
+        <Image src="/globe-network.jpg" alt="" width={220} height={220} />
+      </div>
+      <div className="quality-product-group">
+        {RIGHT_SLUGS.map((slug) => (
+          <ProductBadgeCard key={slug} slug={slug} />
+        ))}
+      </div>
+    </div>
+  );
+}
