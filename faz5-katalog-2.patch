diff --git a/app/globals.css b/app/globals.css
index b763820..127f9e6 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -409,7 +409,10 @@ input, textarea { display: block; width: 100%; border: 0; border-bottom: 1px sol
 input:focus, textarea:focus { border-color: var(--gold); }
 
 .catalog-section .section-heading { margin-bottom: 38px; }
+.catalog-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
 .catalog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 380px)); gap: 18px; }
+.catalog-preview { border-radius: 12px; overflow: hidden; box-shadow: 0 30px 70px rgba(18,23,32,.22); transform: rotate(1.2deg); }
+.catalog-preview img { display: block; width: 100%; height: auto; }
 .catalog-card { background: #fff; padding: 35px; position: relative; min-height: 285px; border-top: 3px solid var(--navy); overflow: hidden; }
 .catalog-card strong { position: absolute; right: 25px; top: 18px; font: 600 72px 'Poppins'; color: #f0ede7; }
 .catalog-icon { color: var(--gold); margin-bottom: 30px; position: relative; }
@@ -469,7 +472,7 @@ input:focus, textarea:focus { border-color: var(--gold); }
   .hero-content { padding-top: 50px; }
   .hero-scroll { display: none; }
 
-  .about-grid, .quality-layout, .together-grid, .contact-grid, .detail-grid { grid-template-columns: 1fr; gap: 42px; }
+  .about-grid, .quality-layout, .together-grid, .contact-grid, .detail-grid, .catalog-layout { grid-template-columns: 1fr; gap: 42px; }
   .intro-heading { margin-bottom: 40px; }
   .section-padding { padding: 74px 0; }
   .intro-copy { padding-top: 0; }
