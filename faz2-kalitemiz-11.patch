index 086e225..f99c496 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -374,15 +374,16 @@ h1 em, h2 em { font-family: var(--font-caveat), cursive; font-weight: 500; color
   background: radial-gradient(ellipse at center, rgba(18,23,32,.22) 0%, rgba(18,23,32,0) 72%);
 }
 
-/* Dünya görseli: kaynak fotoğrafın siyah zemini "screen" blend modu ile
-   kayboluyor (yalnızca parlak lacivert/turuncu ağ çizgileri kalıyor),
+/* Dünya görseli: gerçek alfa şeffaflığı olan bir PNG kullanıyoruz (siyah
+   zemin ImageMagick ile pikselden kaldırıldı — CSS mix-blend-mode
+   denemesi güvenilir çalışmadığı için bu daha kesin bir yöntem).
    perspective + rotateY ile gerçek bir 3D eksende yavaşça sağa-sola
    salınıyor. Tam 360° döndürmüyoruz çünkü düz bir fotoğraf ters yüz
    olduğunda (90°/270°) görsel bozulma (ayna gibi tersine dönme) olurdu —
    bu yüzden dürüstçe "canlı, hafif dönen küre" hissini tercih ettik. */
 .quality-globe { width: 230px; height: 230px; flex-shrink: 0; perspective: 900px; }
 .quality-globe img {
-  width: 100%; height: 100%; object-fit: contain; mix-blend-mode: screen;
+  width: 100%; height: 100%; object-fit: contain;
   transform-style: preserve-3d;
   animation: quality-globe-sway 10s ease-in-out infinite;
 }
