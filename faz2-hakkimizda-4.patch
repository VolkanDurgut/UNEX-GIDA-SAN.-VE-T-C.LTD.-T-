 /* ===== HAKKIMIZDA: "Birlikte büyüyen" + İstatistikler — tek, kesintisiz
    lacivert blok. FlourDust bu bloğun tamamını (başlık alanı + istatistik
    şeridi) kaplayacak şekilde bir kez, en dışta render ediliyor. ===== */
-.about-navy-block { position: relative; overflow: hidden; background: linear-gradient(135deg, #0c141c, #091118); color: #fff; }
+.about-navy-block { position: relative; overflow: hidden; background: #07121c; color: #fff; }
 .about-navy-block h2 { font-size: clamp(38px, 5vw, 64px); color: #fff; font-weight: 600; letter-spacing: -.045em; }
 .about-navy-block .eyebrow { color: #fff; }
 .about-navy-block .body-copy p { color: rgba(255,255,255,.78); }
-.about-navy-block > .section-padding { position: relative; z-index: 2; }
+.about-navy-content { padding: 90px 0 56px; position: relative; z-index: 2; }
 .about-navy-block > .stats { position: relative; z-index: 2; }
 
-.stats { padding: 80px 0; }
+.stats { padding: 0 0 90px; }
 .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
 .stat { padding-left: 28px; border-left: 1px solid rgba(255,255,255,.18); display: flex; flex-direction: column; gap: 12px; }
 .stat-icon { color: var(--gold); }
