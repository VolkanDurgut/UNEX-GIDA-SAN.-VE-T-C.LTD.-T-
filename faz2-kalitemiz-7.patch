--- a/app/globals.css
+++ b/app/globals.css
@@ -348,29 +348,10 @@ h1 em, h2 em { font-family: var(--font-caveat), cursive; font-weight: 500; color
 .product-list-section { background: #eeeae2; }
 .product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 18px; }
 
-/* "İşinizi ileri taşırız" — iki çuvaldan dışa yayılan animasyonlu ok/ikon
-   kompozisyonu. Konum yüzdeleri SVG viewBox'ıyla (1000x320) birebir
-   eşleşiyor ki oklar ve ikon rozetleri tam hizalı kalsın. */
-.quality-bag-radial { position: relative; width: 100%; max-width: 980px; aspect-ratio: 1000 / 320; margin: 56px auto 0; }
-.quality-bag-radial-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
-.quality-bag-radial-bag { position: absolute; top: 50%; transform: translate(-50%, -50%); filter: drop-shadow(10px 16px 14px rgba(18,23,32,.16)); z-index: 2; }
-.quality-bag-radial-bag-left { left: 33%; }
-.quality-bag-radial-bag-right { left: 67%; }
-.quality-bag-radial-icon {
-  position: absolute; transform: translate(-50%, -50%); z-index: 2;
-  width: 42px; height: 42px; border-radius: 50%; background: #fff;
-  display: flex; align-items: center; justify-content: center;
-  box-shadow: 0 8px 18px rgba(0,0,0,.25); color: var(--navy);
-}
-
-/* Kalitemiz — "İşinizi ileri taşırız" bölümünün lacivert + un tozu
-   varyasyonu (Hero'dan buraya taşındı). */
-.quality-copy-navy { background: #07121c; color: #fff; position: relative; overflow: hidden; }
-.quality-copy-navy h2 { color: #fff; }
-.quality-copy-navy .eyebrow { color: #fff; }
-.quality-copy-navy .body-copy p { color: rgba(255,255,255,.78); }
-.quality-copy-navy .quality-layout,
-.quality-copy-navy .quality-bag-radial { position: relative; z-index: 2; }
+/* "İşinizi ileri taşırız" — ihracat ağı görseli (gerçek fotoğraf, beyaz
+   zeminde kart görünümünde). */
+.quality-map-visual { margin-top: 56px; border-radius: 12px; overflow: hidden; box-shadow: 0 24px 60px rgba(18,23,32,.18); }
+.quality-map-visual img { display: block; width: 100%; height: auto; }
 
 .contact-section, .catalog-section, .related { background: var(--cream); }
 .contact-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 100px; }
