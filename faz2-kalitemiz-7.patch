-'use client';
-
-import { useRef } from 'react';
-import Image from 'next/image';
-import { motion, useInView } from 'framer-motion';
-import { Leaf, Search, Microscope, BarChart3, Handshake, Cpu } from 'lucide-react';
-
-const LEFT_BAG = '/baker-flour.png';
-const RIGHT_BAG = '/multi-purpose-flour.png';
-
-/** viewBox: 0 0 1000 320. Renkler koyu (lacivert) zemin üzerinde kontrast
- *  için açık beyaz / altın olarak dönüşümlü seçildi. */
-const ARROWS = [
-  { x1: 300, y1: 150, x2: 112, y2: 58, color: 'light' },
-  { x1: 258, y1: 180, x2: 62, y2: 180, color: 'gold' },
-  { x1: 300, y1: 212, x2: 112, y2: 302, color: 'light' },
-  { x1: 700, y1: 150, x2: 888, y2: 58, color: 'gold' },
-  { x1: 742, y1: 180, x2: 938, y2: 180, color: 'light' },
-  { x1: 700, y1: 212, x2: 888, y2: 302, color: 'gold' },
-] as const;
-
-const ICONS = [
-  { x: 112, y: 58, Icon: Leaf },
-  { x: 62, y: 180, Icon: Search },
-  { x: 112, y: 302, Icon: Microscope },
-  { x: 888, y: 58, Icon: BarChart3 },
-  { x: 938, y: 180, Icon: Handshake },
-  { x: 888, y: 302, Icon: Cpu },
-] as const;
-
-const COLORS = { light: 'rgba(255,255,255,.85)', gold: '#e87c48' };
-
-/**
- * "İşinizi ileri taşırız" bölümündeki iki un çuvalından dışa doğru yayılan,
- * her biri lucide ikonlarıyla biten, gerçek zamanlı çizilen (pathLength
- * animasyonu) ok demeti. Sahne görünüme girdiğinde bir kez oynar.
- */
-export function QualityBagRadial() {
-  const ref = useRef<HTMLDivElement>(null);
-  const inView = useInView(ref, { once: true, amount: 0.4 });
-
-  return (
-    <div ref={ref} className="quality-bag-radial">
-      <svg viewBox="0 0 1000 320" className="quality-bag-radial-svg">
-        <defs>
-          <marker id="arrowhead-light" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
-            <path d="M0,0 L9,4.5 L0,9 Z" fill={COLORS.light} />
-          </marker>
-          <marker id="arrowhead-gold" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
-            <path d="M0,0 L9,4.5 L0,9 Z" fill={COLORS.gold} />
-          </marker>
-        </defs>
-        {ARROWS.map((a, i) => (
-          <motion.line
-            key={i}
-            x1={a.x1}
-            y1={a.y1}
-            x2={a.x2}
-            y2={a.y2}
-            stroke={COLORS[a.color]}
-            strokeWidth={3}
-            strokeLinecap="round"
-            markerEnd={`url(#arrowhead-${a.color})`}
-            initial={{ pathLength: 0, opacity: 0 }}
-            animate={inView ? { pathLength: 1, opacity: 1 } : {}}
-            transition={{ duration: 0.7, delay: 0.15 * i, ease: 'easeOut' }}
-          />
-        ))}
-      </svg>
-
-      <div className="quality-bag-radial-bag quality-bag-radial-bag-left">
-        <Image src={LEFT_BAG} alt="" width={170} height={225} />
-      </div>
-      <div className="quality-bag-radial-bag quality-bag-radial-bag-right">
-        <Image src={RIGHT_BAG} alt="" width={170} height={225} />
-      </div>
-
-      {ICONS.map(({ x, y, Icon }, i) => (
-        <motion.div
-          key={i}
-          className="quality-bag-radial-icon"
-          style={{ left: `${(x / 1000) * 100}%`, top: `${(y / 320) * 100}%` }}
-          initial={{ opacity: 0, scale: 0.5 }}
-          animate={inView ? { opacity: 1, scale: 1 } : {}}
-          transition={{ duration: 0.35, delay: 0.15 * i + 0.55 }}
-        >
-          <Icon size={19} />
-        </motion.div>
-      ))}
-    </div>
-  );
-}
