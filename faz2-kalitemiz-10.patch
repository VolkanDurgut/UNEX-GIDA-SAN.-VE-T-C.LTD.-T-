diff --git a/app/globals.css b/app/globals.css
index a343f13..086e225 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -354,11 +354,12 @@ h1 em, h2 em { font-family: var(--font-caveat), cursive; font-weight: 500; color
 .page-hero-map-overlay img { object-fit: cover; object-position: center; }
 
 /* "İşinizi ileri taşırız" — 6 gerçek ürünümüz, Türk bayrağı rozetli,
-   ortada yavaşça dönen dünya görseliyle iki yana ayrılmış. */
+   ortada perspective+rotateY ile gerçek 3D salınan bir dünya görseliyle
+   iki yana ayrılmış. */
 .quality-product-showcase { display: flex; align-items: center; justify-content: center; gap: 36px; margin-top: 56px; flex-wrap: wrap; }
-.quality-product-group { display: flex; gap: 18px; }
+.quality-product-group { display: flex; align-items: flex-start; gap: 18px; }
 .quality-product-card { position: relative; text-align: center; width: 96px; }
-.quality-product-card img { width: 100%; height: auto; filter: drop-shadow(6px 10px 10px rgba(18,23,32,.14)); }
+.quality-product-card img { position: relative; z-index: 1; width: 100%; height: auto; filter: drop-shadow(6px 10px 10px rgba(18,23,32,.14)); }
 .quality-product-card p { margin-top: 8px; font-size: 11px; font-weight: 600; color: var(--navy); line-height: 1.4; }
 .quality-product-card p span { display: block; font-weight: 500; color: var(--soft); font-size: 10px; }
 .quality-product-flag {
@@ -367,10 +368,27 @@ h1 em, h2 em { font-family: var(--font-caveat), cursive; font-weight: 500; color
   display: flex; align-items: center; justify-content: center;
   font-size: 13px; box-shadow: 0 2px 6px rgba(0,0,0,.18);
 }
-.quality-globe { width: 200px; height: 200px; border-radius: 50%; overflow: hidden; flex-shrink: 0; box-shadow: 0 10px 30px rgba(18,23,32,.2); }
-.quality-globe img { width: 100%; height: 100%; object-fit: cover; animation: quality-globe-spin 40s linear infinite; }
-@keyframes quality-globe-spin {
-  to { transform: rotate(360deg); }
+/* Çuvalın altına, zemine oturmuş hissi veren yumuşak oval gölge. */
+.quality-product-shadow {
+  width: 70%; height: 14px; margin: 2px auto 0;
+  background: radial-gradient(ellipse at center, rgba(18,23,32,.22) 0%, rgba(18,23,32,0) 72%);
+}
+
+/* Dünya görseli: kaynak fotoğrafın siyah zemini "screen" blend modu ile
+   kayboluyor (yalnızca parlak lacivert/turuncu ağ çizgileri kalıyor),
+   perspective + rotateY ile gerçek bir 3D eksende yavaşça sağa-sola
+   salınıyor. Tam 360° döndürmüyoruz çünkü düz bir fotoğraf ters yüz
+   olduğunda (90°/270°) görsel bozulma (ayna gibi tersine dönme) olurdu —
+   bu yüzden dürüstçe "canlı, hafif dönen küre" hissini tercih ettik. */
+.quality-globe { width: 230px; height: 230px; flex-shrink: 0; perspective: 900px; }
+.quality-globe img {
+  width: 100%; height: 100%; object-fit: contain; mix-blend-mode: screen;
+  transform-style: preserve-3d;
+  animation: quality-globe-sway 10s ease-in-out infinite;
+}
+@keyframes quality-globe-sway {
+  0%, 100% { transform: rotateY(-22deg); }
+  50% { transform: rotateY(22deg); }
 }
 
 .contact-section, .catalog-section, .related { background: var(--cream); }
