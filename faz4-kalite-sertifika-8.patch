+.cert-badges-image { margin: 20px 0 22px; max-width: 620px; }
 .cert-badges-image img { display: block; width: 100%; height: auto; }
-.cert-note { max-width: 560px; font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.6; }
+.cert-note { max-width: 560px; font-size: 14px; color: var(--soft); line-height: 1.6; }
 .product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 18px; }
 
