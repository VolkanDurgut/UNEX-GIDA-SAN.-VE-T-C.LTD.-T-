diff --git a/components/floating-bag.tsx b/components/floating-bag.tsx
new file mode 100644
index 0000000..0c93fe5
--- /dev/null
+++ b/components/floating-bag.tsx
@@ -0,0 +1,37 @@
+'use client';
+
+import Image from 'next/image';
+import { motion } from 'framer-motion';
+
+/**
+ * Sürekli, yumuşak bir "yüzme" animasyonuyla dönen ürün paketi. `phase`
+ * (0-1) her paketin animasyon döngüsünde birbirinden farklı bir noktada
+ * başlamasını sağlar — bu "denklem" sayesinde paketler senkronize değil,
+ * organik/canlı bir ritimde hareket eder.
+ */
+export function FloatingBag({
+  src,
+  width = 190,
+  height = 250,
+  phase = 0,
+}: {
+  src: string;
+  width?: number;
+  height?: number;
+  phase?: number;
+}) {
+  return (
+    <motion.div
+      className="floating-bag"
+      animate={{ y: [0, -10, 0, 6, 0] }}
+      transition={{
+        duration: 6,
+        repeat: Infinity,
+        ease: 'easeInOut',
+        delay: phase * 6,
+      }}
+    >
+      <Image src={src} alt="" width={width} height={height} />
+    </motion.div>
+  );
+}
diff --git a/components/hero-slideshow.tsx b/components/hero-slideshow.tsx
new file mode 100644
index 0000000..e3de449
--- /dev/null
+++ b/components/hero-slideshow.tsx
@@ -0,0 +1,45 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+import Image from 'next/image';
+import { AnimatePresence, motion } from 'framer-motion';
+
+/**
+ * Hero fotoğrafını sabit tek bir kare yerine, birden fazla gerçek fotoğraf
+ * arasında otomatik, yumuşak bir crossfade ile döndürür — sinematik bir
+ * "klip" hissi verir, video prodüksiyonuna gerek kalmadan.
+ */
+export function HeroSlideshow({
+  images,
+  interval = 5500,
+}: {
+  images: string[];
+  interval?: number;
+}) {
+  const [index, setIndex] = useState(0);
+
+  useEffect(() => {
+    if (images.length <= 1) return;
+    const id = setInterval(() => {
+      setIndex((i) => (i + 1) % images.length);
+    }, interval);
+    return () => clearInterval(id);
+  }, [images.length, interval]);
+
+  return (
+    <div className="hero-slideshow">
+      <AnimatePresence initial={false}>
+        <motion.div
+          key={images[index]}
+          className="hero-slideshow-frame"
+          initial={{ opacity: 0 }}
+          animate={{ opacity: 1 }}
+          exit={{ opacity: 0 }}
+          transition={{ duration: 1.4, ease: 'easeInOut' }}
+        >
+          <Image src={images[index]} alt="" fill priority sizes="100vw" />
+        </motion.div>
+      </AnimatePresence>
+    </div>
+  );
+}
