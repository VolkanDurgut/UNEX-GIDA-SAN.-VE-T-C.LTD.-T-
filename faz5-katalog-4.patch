diff --git a/app/globals.css b/app/globals.css
index afbdbb3..9055fee 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -414,7 +414,7 @@ input:focus, textarea:focus { border-color: var(--gold); }
 /* Gerçek katalog sayfalarından oluşan, hafif yelpaze şeklinde önizleme yığını. */
 .catalog-stack { position: relative; height: 420px; max-width: 460px; }
 .stack-page { position: absolute; width: 320px; border-radius: 10px; overflow: hidden; box-shadow: 0 24px 55px rgba(18,23,32,.28); }
-.stack-page img { display: block; width: 100%; height: auto; }
+.stack-page img, .stack-page video { display: block; width: 100%; height: auto; }
 .stack-page-3 { top: 55px; left: 90px; transform: rotate(9deg); z-index: 1; }
 .stack-page-2 { top: 25px; left: 45px; transform: rotate(-6deg); z-index: 2; }
 .stack-page-1 { top: 0; left: 0; transform: rotate(2deg); z-index: 3; }
